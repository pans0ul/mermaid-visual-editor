{
  "name": "mermaid-visual-editor",
  "version": "0.2.0",
  "private": false,
  "description": "Visual drag-and-drop editor for Mermaid.js diagrams. Build flowcharts visually — export clean .mmd syntax.",
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "visual-editor",
    "drag-and-drop",
    "mermaid.js",
    "react-flow"
  ],
  "license": "MIT",
  "author": "Saket Kattuboina",
  "homepage": "https://mermaid-visual-editor-delta.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pans0ul/mermaid-visual-editor.git"
  },
  "bugs": {
    "url": "https://github.com/pans0ul/mermaid-visual-editor/issues"
  },
  "engines": {
    "node": ">=20.9"
  },
  "main": "electron/main.cjs",
  "bin": {
    "mermaid-visual-editor": "bin/cli.js"
  },
  "files": [
    "out/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node bin/cli.js",
    "lint": "eslint",
    "desktop:start": "electron .",
    "desktop:smoke": "electron . --smoke",
    "desktop:pack": "electron-builder --win --dir",
    "desktop:dist": "electron-builder --win --publish never",
    "desktop:dist:linux": "electron-builder --linux --publish never",
    "desktop:dist:mac": "electron-builder --mac --publish never --x64 --arm64"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@xyflow/react": "^12.10.1",
    "mermaid": "^11.12.3",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "serve": "^14.2.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.53",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
